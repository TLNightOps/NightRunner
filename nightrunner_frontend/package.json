{
  "name": "nightrunner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:authentik": "vite --mode authentik",
    "dev:firebase": "vite --mode firebase",
    "build": "vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first 'http-server storybook-static -p 6006' 'test-storybook'"
  },
  "dependencies": {
    "env-cmd": "^11.0.0",
    "firebase": "^12.18.0",
    "html5-qrcode": "^2.3.8",
    "jwt-decode": "^4.0.0",
    "oidc-client-ts": "^3.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-oidc-context": "^3.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test-runner": "^0.24.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "chromatic": "^18.8.1",
    "concurrently": "^10.0.5",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "oxlint": "^1.82.0",
    "storybook": "^8.6.18",
    "vite": "^8.2.4",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
